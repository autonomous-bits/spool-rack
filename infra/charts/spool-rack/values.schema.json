{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Spool Rack chart values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string", "minLength": 1 },
        "mountPath": { "type": "string", "minLength": 1 },
        "subPath": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "volumeMode": { "type": "string" },
        "reclaimPolicy": { "type": "string" },
        "existingClaim": { "type": "string" },
        "annotations": { "type": "object" },
        "labels": { "type": "object" },
        "csi": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "inline": { "type": "boolean" },
            "driver": { "type": "string" },
            "volumeHandle": { "type": "string" },
            "readOnly": { "type": "boolean" },
            "fsType": { "type": "string" },
            "volumeAttributes": { "type": "object" },
            "nodePublishSecretRef": { "type": "object" },
            "nodeStageSecretRef": { "type": "object" },
            "controllerExpandSecretRef": { "type": "object" }
          }
        }
      }
    },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" }
  }
}
